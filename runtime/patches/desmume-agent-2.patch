+
+// no$gba debug output capture ------------------------------------------------
+static const size_t AGENT_DBG_CAP = 64 * 1024;
+static char agent_dbg_ring[AGENT_DBG_CAP];
+static size_t agent_dbg_head = 0;
+static size_t agent_dbg_len = 0;
+
+static void agent_dbg_push(const char* s, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        if (agent_dbg_len == AGENT_DBG_CAP) {
+            agent_dbg_head = (agent_dbg_head + 1) % AGENT_DBG_CAP;
+            agent_dbg_len--;
+        }
+        agent_dbg_ring[(agent_dbg_head + agent_dbg_len) % AGENT_DBG_CAP] = s[i];
+        agent_dbg_len++;
+    }
+}
+
+EXPORTED int desmume_agent_debug_read(char* buf, int cap)
+{
+    if (buf == NULL || cap <= 0) return 0;
+    size_t n = agent_dbg_len;
+    if (n > (size_t)(cap - 1)) n = (size_t)(cap - 1);
+    for (size_t i = 0; i < n; i++)
+        buf[i] = agent_dbg_ring[(agent_dbg_head + i) % AGENT_DBG_CAP];
+    buf[n] = 0;
+    agent_dbg_head = (agent_dbg_head + n) % AGENT_DBG_CAP;
+    agent_dbg_len -= n;
+    return (int)n;
+}
+
+// Expands the no$gba %param% subset that makes sense without a debugger:
+// %r0%..%r15%, %sp%, %lr%, %pc%, %frame%, %scanline%, %%. Unknown tokens are
+// passed through verbatim.
+static void agent_dbg_expand(int procnum, const std::string& in, std::string& out)
+{
+    armcpu_t& cpu = procnum == ARMCPU_ARM9 ? NDS_ARM9 : NDS_ARM7;
+    size_t i = 0;
+    while (i < in.size()) {
+        if (in[i] != '%') { out += in[i++]; continue; }
+        size_t j = in.find('%', i + 1);
+        if (j == std::string::npos || j - i > 12) { out += in[i++]; continue; }
+        std::string tok = in.substr(i + 1, j - i - 1);
+        char tmp[16];
+        int reg = -1;
+        if (tok.empty()) { out += '%'; i = j + 1; continue; }
+        if (tok == "sp") reg = 13;
+        else if (tok == "lr") reg = 14;
+        else if (tok == "pc") reg = 15;
+        else if (tok[0] == 'r' && tok.size() <= 3 && tok.find_first_not_of("0123456789", 1) == std::string::npos) {
+            int v = atoi(tok.c_str() + 1);
+            if (v >= 0 && v <= 15) reg = v;
+        }
+        if (reg >= 0) {
+            snprintf(tmp, sizeof(tmp), "%08X", cpu.R[reg]);
+            out += tmp; i = j + 1; continue;
+        }
+        if (tok == "frame") { snprintf(tmp, sizeof(tmp), "%d", currFrameCounter); out += tmp; i = j + 1; continue; }
+        if (tok == "scanline") { snprintf(tmp, sizeof(tmp), "%u", (unsigned)nds.VCount); out += tmp; i = j + 1; continue; }
+        out += in[i++];
+    }
+}
+
+// Called from validateIORegsWrite (MMU.cpp) for 0x04FFFA00..0x04FFFA3F.
+// Registers (BlocksDS libnds <nds/debug.h>, GBATEK no$gba):
+//   0x04FFFA10 string pointer, raw             0x04FFFA14 string pointer, %params%
+//   0x04FFFA18 string pointer, %params% + LF   0x04FFFA1C character
+// Every captured message is stored followed by '\n' (unless it already ends with one).
+bool agent_nocash_write(int procnum, u32 addr, u32 size, u32 val)
+{
+    u32 a = addr & 0x0FFFFFFF;
+    if (a == 0x04FFFA10 || a == 0x04FFFA14 || a == 0x04FFFA18) {
+        if (size != 32) return true;
+        std::string s;
+        for (u32 p = val; s.size() < 256; p++) {
+            u8 c = _MMU_read08(procnum, MMU_AT_DEBUG, p);
+            if (c == 0) break;
+            s += (char)c;
+        }
+        std::string out;
+        if (a == 0x04FFFA10) out = s; else agent_dbg_expand(procnum, s, out);
+        if (out.empty() || out[out.size() - 1] != '\n') out += '\n';
+        agent_dbg_push(out.data(), out.size());
+        return true;
+    }
+    if (a == 0x04FFFA1C) {
+        char c = (char)(val & 0xFF);
+        agent_dbg_push(&c, 1);
+        return true;
+    }
+    return true; // swallow other debug-register writes (no "undefined register" spam)
+}
