+// Headless input ABI state. ARM9's inline memory path must see the same
+// keypad mask as the exported frontend API; it otherwise bypasses MMU.cpp's
+// register readers and returns the stale backing array.
+extern u16 agent_keypad_state;
+FORCEINLINE u16 agent_keyinput_value_inline()
+{
+	return (u16)(~agent_keypad_state & 0x03FF);
+}
